# ---------------------------------------------------------------
# AI Provider — paste ONE of the following keys.
# Provider is auto-detected from the key prefix:
#   gsk_...  → Groq  (free tier: ~14,400 req/day, no billing needed)
#   AIza...  → Gemini (free tier: 20 req/day on 2.5-flash)
# ---------------------------------------------------------------
GEMINI_API_KEY=gsk_your_groq_key_here
# GEMINI_API_KEY=AIzaSy_your_gemini_key_here

# Optional: override the default model for the detected provider
# Groq models:   llama-3.3-70b-versatile | llama-3.1-8b-instant | gemma2-9b-it
# Gemini models: gemini-2.5-flash | gemini-2.0-flash | gemini-1.5-flash
# GEMINI_MODEL=llama-3.3-70b-versatile

PORT=8000
HOST=0.0.0.0
